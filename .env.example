# Copy to .env.local and fill in. Never commit real values.

# New admin database (Phase 1 spec, Section 2.4)
DATABASE_URL=mysql://t2_admin_user:CHANGE_ME@localhost:3306/t2_admin

# First Super Admin, created by `npm run db:seed` (only if no user with this username exists)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_long_random_password
